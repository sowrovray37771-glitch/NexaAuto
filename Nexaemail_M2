class _DATA_BLOB(ctypes.Structure):

    _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_ubyte))]

def _unprotect_current_user_dpapi(encrypted: bytes) -> bytes:

    """Use Windows' own DPAPI; same Windows user who saved the numbers."""

    if os.name != 'nt':

        raise RuntimeError('Number extension is stored using Windows DPAPI; run on Windows.')

    if not encrypted:

        raise RuntimeError('Number extension file is empty.')

    crypt32 = ctypes.WinDLL('crypt32', use_last_error=True)

    kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)

    unprotect = crypt32.CryptUnprotectData

    unprotect.argtypes = [ctypes.POINTER(_DATA_BLOB), ctypes.c_void_p,

                          ctypes.POINTER(_DATA_BLOB), ctypes.c_void_p,

                          ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(_DATA_BLOB)]

    unprotect.restype = wintypes.BOOL

    free = kernel32.LocalFree

    free.argtypes = [ctypes.c_void_p]

    free.restype = ctypes.c_void_p

    buffer = (ctypes.c_ubyte * len(encrypted)).from_buffer_copy(encrypted)

    source = _DATA_BLOB(len(encrypted), ctypes.cast(buffer, ctypes.POINTER(ctypes.c_ubyte)))

    output = _DATA_BLOB()

    if not unprotect(ctypes.byref(source), None, None, None, None, 0,

                     ctypes.byref(output)):

        code = ctypes.get_last_error()

        raise RuntimeError('Could not read Number extension using this Windows user '

                           f'(DPAPI Windows error {code}). Use the same Windows account '

                           'that saved the extension numbers.')

    try:

        return ctypes.string_at(output.pbData, output.cbData)

    finally:

        if output.pbData:

            ctypes.memset(output.pbData, 0, output.cbData)

            free(ctypes.cast(output.pbData, ctypes.c_void_p))


# ----- Email address: switch from mobile signup, then WAIT for manual paste -----
EMAIL_PASTE_TIMEOUT = 600.0  # manual step: allow up to ten minutes
EMAIL_STABLE_SECONDS = 0.9   # avoid clicking while the user is still typing

EMAIL_FIELD_JS = r"""
(() => {
  const mark = 'data-nexa-py-email';
  const norm = s => String(s || '').toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ').trim();
  const visible = el => {
    if (!el || !el.isConnected || el.disabled || el.readOnly) return false;
    const r=el.getBoundingClientRect(), st=getComputedStyle(el);
    return r.width>0 && r.height>0 && st.visibility!=='hidden' && st.display!=='none';
  };
  const exact = new Set(['email address','email','e mail','e mail address']);
  const matches=[];
  for (const el of document.querySelectorAll('input')) {
    if (!visible(el)) continue;
    const type=norm(el.getAttribute('type')||'text');
    if (type!=='email' && type!=='text') continue;
    const meta=[el.getAttribute('placeholder'),el.getAttribute('aria-label'),
      el.getAttribute('name'),el.getAttribute('id'),el.getAttribute('autocomplete')];
    if (el.labels) for (const label of el.labels) meta.push(label.innerText || label.textContent);
    const by=el.getAttribute('aria-labelledby');
    if(by) for(const id of by.split(/\s+/)) {
      const label=document.getElementById(id); if(label) meta.push(label.textContent);
    }
    if (type==='email' || meta.some(x=>exact.has(norm(x)))) matches.push(el);
  }
  document.querySelectorAll('['+mark+']').forEach(el=>el.removeAttribute(mark));
  if(matches.length!==1) return {status:matches.length?'ambiguous':'missing',count:matches.length};
  const el=matches[0];
  el.setAttribute(mark,'true');
  const email=el.value.trim();
  const formatOk=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  const nativeOk=el.type!=='email' || el.checkValidity();
  return {status:'ready',value:email,valid:formatOk && nativeOk};
})()
"""

NEXT_BUTTON_JS = r"""
(() => {
  const norm = s => String(s || '').replace(/\s+/g,' ').trim().toLowerCase();
  const visible = e => {
    const r=e.getBoundingClientRect(), st=getComputedStyle(e);
    return r.width>0 && r.height>0 && st.display!=='none' && st.visibility!=='hidden';
  };
  const nodes=[...document.querySelectorAll('button,a,[role="button"],input[type="submit"],input[type="button"]')];
  const matches=nodes.filter(e => visible(e) && norm(e.innerText || e.value || e.getAttribute('aria-label') || e.textContent)==='next');
  if(matches.length!==1) return {status:matches.length?'ambiguous':'missing'};
  const b=matches[0];
  return {status:'ready',enabled:!b.disabled && b.getAttribute('aria-disabled')!=='true'};
})()
"""


def switch_to_email_signup(browser: NexaBrowser, settings: Settings) -> None:
    print('[email] Looking for Sign up with email address...', flush=True)
    wait_for_exact_buttons(browser, ('Sign up with email address',))
    action_wait(settings, 'Sign up with email address click')
    browser.click_text('Sign up with email address')
    print('[email] Email signup chosen. Paste your email manually into the page.', flush=True)


def wait_for_manual_email_and_next(browser: NexaBrowser, settings: Settings) -> None:
    # Do not fill, generate, access an extension, or log the email value.
    deadline = time.monotonic() + EMAIL_PASTE_TIMEOUT
    previous_value = None
    stable_since = None
    field_announced = False
    while time.monotonic() < deadline:
        result = browser.evaluate(EMAIL_FIELD_JS)
        if not isinstance(result, dict):
            raise RuntimeError('Could not inspect Email address field.')
        if result.get('status') == 'ambiguous':
            raise RuntimeError('Multiple Email address fields found; no Next click attempted.')
        if result.get('status') != 'ready':
            previous_value, stable_since = None, None
            time.sleep(0.3)
            continue
        if not field_announced:
            print('[email] Email field ready. Waiting for your manual paste...', flush=True)
            field_announced = True
        if not result.get('valid'):
            previous_value, stable_since = None, None
            time.sleep(0.3)
            continue
        current_value = result.get('value')
        if current_value != previous_value or stable_since is None:
            previous_value, stable_since = current_value, time.monotonic()
            time.sleep(0.2)
            continue
        if time.monotonic() - stable_since < EMAIL_STABLE_SECONDS:
            time.sleep(0.2)
            continue
        next_state = browser.evaluate(NEXT_BUTTON_JS)
        if not isinstance(next_state, dict) or next_state.get('status') != 'ready' or not next_state.get('enabled'):
            time.sleep(0.3)
            continue
        # Keep the same randomized per-action delay used by all other stages.
        action_wait(settings, 'Next click after manually pasted email')
        confirm = browser.evaluate(EMAIL_FIELD_JS)
        next_confirm = browser.evaluate(NEXT_BUTTON_JS)
        if (isinstance(confirm, dict) and confirm.get('status') == 'ready'
                and confirm.get('valid') is True
                and confirm.get('value') == current_value
                and isinstance(next_confirm, dict) and next_confirm.get('status') == 'ready'
                and next_confirm.get('enabled') is True):
            browser.click_text('Next')
            print('[email] Next clicked after manual email detection (email hidden).', flush=True)
            return
        # The user changed the input during the wait, so restart verification.
        previous_value, stable_since = None, None
    raise TimeoutError('No stable valid email and enabled Next button within ten minutes. No click sent.')

# ----- Password Extension text -> password page -> Save (one time only) -----

# Source verified: GlobalExtensionStore.PasswordPath =

# %LOCALAPPDATA%\FB UA Browser Lite\SharedExtensions\password.dpapi

# This extension stores ONE shared UTF-8 string protected with Windows

# DPAPI CurrentUser. Read directly under the same Windows account without

# using the clipboard or printing plaintext in the Runner logs.

def get_extension_password() -> str:

    local = os.environ.get('LOCALAPPDATA')

    if not local:

        raise RuntimeError('LOCALAPPDATA is missing; run in Windows NexaBrowser.')

    source = Path(local) / 'FB UA Browser Lite' / 'SharedExtensions' / 'password.dpapi'

    if not source.is_file():

        raise RuntimeError('Password extension has no saved text. Set it inside NexaBrowser first.')

    password_bytes = _unprotect_current_user_dpapi(source.read_bytes())

    try:

        password = password_bytes.decode('utf-8')

    except UnicodeDecodeError as exc:

        raise RuntimeError('Saved Password extension text is not valid UTF-8.') from exc

    if not password:

        raise RuntimeError('Password extension saved value is empty.')

    if any(c in password for c in ('\r', '\n', '\x00')):

        raise RuntimeError('Password extension value cannot be used in a single-line password field.')

    return password

PASSWORD_FIELD_JS = r"""

(() => {

  const mark = 'data-nexa-py-password';

  const visible = el => {

    const r = el.getBoundingClientRect(), s = getComputedStyle(el);

    return r.width > 0 && r.height > 0 && s.display !== 'none' &&

      s.visibility !== 'hidden' && !el.disabled && !el.readOnly;

  };

  // The screenshot identifies one visible Password input. Do not guess if

  // multiple visible password inputs appear (e.g. password + confirmation).

  const matches = [...document.querySelectorAll('input[type="password"]')].filter(visible);

  document.querySelectorAll('[' + mark + ']').forEach(e => e.removeAttribute(mark));

  if (matches.length !== 1)

    return {status:matches.length ? 'ambiguous' : 'missing', count:matches.length};

  const field = matches[0];

  field.setAttribute(mark, 'true');

  return {status:'ready', value:field.value || ''};

})()

"""

def password_field_state(browser: NexaBrowser) -> dict:

    result = browser.evaluate(PASSWORD_FIELD_JS)

    if not isinstance(result, dict):

        raise RuntimeError('Could not inspect password field.')

    return result

def wait_for_password_field(browser: NexaBrowser, timeout: float = FORM_TIMEOUT) -> None:

    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:

        result = password_field_state(browser)

        if result.get('status') == 'ready':

            print('[password] Found one visible Password field.', flush=True)

            return

        if result.get('status') == 'ambiguous':

            raise RuntimeError('Multiple Password fields found; refusing to guess.')

        time.sleep(0.3)

    raise TimeoutError('Password field not visible in 45 seconds.')

def fill_password_from_extension(browser: NexaBrowser, settings: Settings) -> None:

    wait_for_password_field(browser)

    action_wait(settings, 'Read Password extension text')

    password = get_extension_password()

    print('[password] Saved extension text loaded securely (hidden).', flush=True)

    action_wait(settings, 'Fill Password field')

    browser.fill('input[type="password"][data-nexa-py-password="true"]', password)

    check = password_field_state(browser)

    if check.get('status') != 'ready' or check.get('value') != password:

        raise RuntimeError('Password field did not retain the supplied value; Next not clicked.')

    # Avoid printing the entered secret or the resulting response containing it.

    del password

    del check

    print('[password] Password field filled and verified (text hidden).', flush=True)

def click_save(browser: NexaBrowser, settings: Settings) -> None:

    # The screenshot's confirmation page has both Save and Not now.

    # Require this pair before clicking to avoid unrelated Save buttons.

    probe = BUTTONS_JS.replace(

        "new Set(['get started', 'find my account'])",

        "new Set(['save', 'not now'])"

    )

    deadline = time.monotonic() + FORM_TIMEOUT

    while time.monotonic() < deadline:

        result = browser.evaluate(probe)

        if isinstance(result, list) and {'save','not now'}.issubset(set(result)):

            action_wait(settings, 'Save click')

            browser.click_text('Save')

            print('[click] Save clicked; waiting for next page. Website result not independently confirmed.', flush=True)

            return

        time.sleep(0.3)

    raise TimeoutError('Expected Save + Not now confirmation page was not found; no click sent.')

# ----- Terms acknowledgement (user-requested) and verification method -----

# No changes to earlier stages. Require exact expected pages before taking

# any action; do not click a similarly named control on an unrelated page.

def wait_for_exact_buttons(browser: NexaBrowser, labels: tuple[str, ...], timeout: float = FORM_TIMEOUT) -> None:

    query = BUTTONS_JS.replace(

        "new Set(['get started', 'find my account'])",

        'new Set(' + json.dumps([name.lower() for name in labels]) + ')',

    )

    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:

        result = browser.evaluate(query)

        if isinstance(result, list) and set(name.lower() for name in labels).issubset(result):

            return

        time.sleep(0.3)

    raise TimeoutError('Expected button(s) not found: ' + ', '.join(labels))

def click_i_agree(browser: NexaBrowser, settings: Settings) -> None:

    print('[terms] Waiting for I agree button...', flush=True)

    wait_for_exact_buttons(browser, ('I agree',))

    action_wait(settings, 'I agree click')

    browser.click_text('I agree')

    print('[click] I agree', flush=True)

def run_flow(browser: NexaBrowser, settings: Settings) -> None:
    print('[1/12] Open URL in current NexaBrowser tab:', settings.url, flush=True)
    browser.navigate(settings.url)

    print('[2/12] Wait for Get Started...', flush=True)
    wait_for_get_started(browser)
    action_wait(settings, 'Get Started click')
    browser.click_text('Get Started')
    print('[click] Get Started', flush=True)

    print('[3/12] Wait for name fields...', flush=True)
    wait_for_fields(browser)
    first = random.choice(FIRST_NAMES)
    surname = random.choice(SURNAMES)
    fill_and_confirm(browser, settings, 'first', first)
    fill_and_confirm(browser, settings, 'surname', surname)
    if (field_state(browser,'first').get('value') != first or
            field_state(browser,'surname').get('value') != surname):
        raise RuntimeError('Name fields lost their values; stopped')
    click_next(browser, settings, 'name')

    year = random.randint(1980, 2000)
    month = random.randint(1, 12)
    day = random.randint(1, 28)
    print('[4/12] Wait for Date of birth fields...', flush=True)
    set_date(browser, settings, year, month, day)
    click_next(browser, settings, 'date of birth')

    gender = random.choice(('Female', 'Male'))
    print('[5/12] Wait for gender radio choices...', flush=True)
    select_gender(browser, settings, gender)
    click_next(browser, settings, 'gender')

    print('[6/12] Switch from mobile signup to email...', flush=True)
    switch_to_email_signup(browser, settings)

    print('[7/12] Wait for manual Email address paste...', flush=True)
    wait_for_manual_email_and_next(browser, settings)

    print('[8/12] Wait for Password field...', flush=True)
    fill_password_from_extension(browser, settings)
    click_next(browser, settings, 'password')

    print('[9/12] Wait for Save / Not now confirmation...', flush=True)
    click_save(browser, settings)

    print('[10/12] Wait for I agree...', flush=True)
    click_i_agree(browser, settings)

    print('[complete] I agree clicked. Script finished. No number was used or deleted.', flush=True)


def main() -> int:

    try:

        assert len(FIRST_NAMES) == len(set(FIRST_NAMES)) == 50

        assert len(SURNAMES) == len(set(SURNAMES)) == 50

        settings = get_settings()

        print(f"[settings] Action Time: {settings.minimum_ms}-{settings.maximum_ms} ms", flush=True)

        browser = NexaBrowser(timeout=60)

        run_flow(browser, settings)

        return 0

    except Cancelled:

        print("[cancelled] Nothing was opened.", flush=True)

        return 0

    except (ValueError, RuntimeError, TimeoutError, NexaAutomationError, EOFError) as exc:

        print(f"[error] {exc}", flush=True)

        print("[hint] Run from NexaAura > Python Runner in the updated NexaBrowser.", flush=True)

        return 1

    except KeyboardInterrupt:

        print("[stopped] User interrupted automation.", flush=True)

        return 130

    except Exception as exc:

        print(f"[unexpected error] {type(exc).__name__}: {exc}", flush=True)

        return 2

if __name__ == "__main__":

    sys.exit(main())
