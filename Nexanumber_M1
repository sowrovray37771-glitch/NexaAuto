# Custom mobile UIs frequently draw a "radio" using an SVG/div with no actual
# <input type=radio>. Detect the row by the exact visible label, not by input
# presence. Click its row with WebView2's trusted CDP mouse click and verify the
# selected state via native/ARIA state OR contrasted radio-indicator styling.
# We NEVER click Continue if we cannot verify SMS became selected.
SMS_RADIO_JS = r"""
(() => {
  const mark = 'data-nexa-py-sms-choice';
  const norm = s => String(s || '').replace(/\s+/g, ' ').trim().toLowerCase();
  const visible = el => {
    if (!el || !el.isConnected) return false;
    const r = el.getBoundingClientRect();
    const w = el.ownerDocument.defaultView;
    const st = w.getComputedStyle(el);
    return r.width > 0 && r.height > 0 && st.display !== 'none' &&
           st.visibility !== 'hidden' && st.opacity !== '0';
  };
  function textOf(el) { return norm(el.innerText || el.textContent); }
  function row(label, other) {
    const candidates = Array.from(document.querySelectorAll('label,span,div,p,button,strong,b,section'))
      .filter(el => visible(el) && textOf(el) === label &&
        !Array.from(el.children).some(c => visible(c) && textOf(c) === label));
    const roots = [];
    for (const candidate of candidates) {
      let current = candidate, best = candidate;
      for (let depth = 0; depth < 11 && current; depth++, current = current.parentElement) {
        const txt = textOf(current);
        if (txt.includes(other) || !txt.includes(label)) break;
        if (visible(current)) best = current;
      }
      if (!roots.includes(best)) roots.push(best);
    }
    return roots.length === 1 ? roots[0] : null;
  }
  function semantic(el) {
    const nodes = [el, ...el.querySelectorAll('input[type="radio"], [role="radio"], [aria-checked], [aria-selected], [data-state]')];
    for (const node of nodes) {
      if (node.matches('input[type="radio"]')) return !!node.checked;
      const v = node.getAttribute('aria-checked') || node.getAttribute('aria-selected') || node.getAttribute('data-state');
      if (v === 'true' || v === 'checked') return true;
      if (v === 'false' || v === 'unchecked') return false;
    }
    return null;
  }
  function isBlue(value) {
    if (!value || value === 'none' || value === 'transparent') return false;
    let m = String(value).match(/rgba?\(\s*(\d+)[, ]+\s*(\d+)[, ]+\s*(\d+)/i);
    let r,g,b;
    if (m) { [,r,g,b] = m.map(Number); }
    else {
      m = String(value).match(/^#([0-9a-f]{6})$/i);
      if (!m) return false;
      r=parseInt(m[1].slice(0,2),16); g=parseInt(m[1].slice(2,4),16); b=parseInt(m[1].slice(4,6),16);
    }
    return b > 130 && b > r + 55 && b > g + 35;
  }
  function indicatorBlue(el) {
    // Radio indicators are typically near the trailing edge of each choice row.
    const base = el.getBoundingClientRect(), mid = base.left + base.width * 0.55;
    let count = 0;
    for (const node of [el, ...el.querySelectorAll('*')]) {
      if (!visible(node)) continue;
      const r = node.getBoundingClientRect();
      if (r.left + r.width/2 < mid || r.width > 70 || r.height > 70 || r.width < 5 || r.height < 5) continue;
      const st = getComputedStyle(node);
      const attrs = [node.getAttribute('fill'), node.getAttribute('stroke'), node.getAttribute('color')];
      const vals = [st.borderTopColor, st.borderRightColor, st.backgroundColor, st.color, st.fill, st.stroke, ...attrs];
      if (vals.some(isBlue)) count++;
    }
    return count;
  }
  document.querySelectorAll('[' + mark + ']').forEach(el => el.removeAttribute(mark));
  const sms = row('send code via sms', 'send code via whatsapp');
  const wa = row('send code via whatsapp', 'send code via sms');
  if (!sms || !wa || sms === wa) return {status:'missing', reason:'Cannot find both exact choice rows'};
  const smsState = semantic(sms), waState = semantic(wa);
  let selected = null, method = 'unknown';
  if (smsState !== null) { selected=smsState; method='semantic'; }
  else if (waState !== null) { selected=!waState; method='opposite-semantic'; }
  else {
    const blueSms=indicatorBlue(sms), blueWa=indicatorBlue(wa);
    if (blueSms > 0 && blueWa === 0) { selected=true; method='visual'; }
    else if (blueWa > 0 && blueSms === 0) { selected=false; method='visual'; }
  }
  // The whole row is targeted so custom radio click handlers attached to the
  // parent container are triggered, even when there is no radio input element.
  sms.setAttribute(mark, 'true');
  return {status:'ready', selected, method};
})()
"""


def sms_state(browser: NexaBrowser) -> dict:
