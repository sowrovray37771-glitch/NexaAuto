# ----- Mobile Number step: read the FIRST saved extension number (read-only) -----
# Source confirmed against NexaBrowser v1.5.0:
# AppStorage.Root = %LOCALAPPDATA%\FB UA Browser Lite
# GlobalExtensionStore.NumberPath = <Root>\SharedExtensions\numbers.dpapi
# Contents: UTF-8 lines, encrypted with DPAPI CurrentUser / no entropy.
# The saved order is preserved and the first nonempty line is the list's top
# entry (without applying a search filter in the extension UI).


class _DATA_BLOB(ctypes.Structure):
    _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_ubyte))]


def _unprotect_current_user_dpapi(encrypted: bytes) -> bytes:
    """Use Windows' own DPAPI; same Windows user who saved the numbers."""
    if os.name != 'nt':
        raise RuntimeError('Number extension is stored using Windows DPAPI; run on Windows.')
    if not encrypted:
        raise RuntimeError('Number extension file is empty.')
    crypt32 = ctypes.WinDLL('crypt32', use_last_error=True)
    kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
    unprotect = crypt32.CryptUnprotectData
    unprotect.argtypes = [ctypes.POINTER(_DATA_BLOB), ctypes.c_void_p,
                          ctypes.POINTER(_DATA_BLOB), ctypes.c_void_p,
                          ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(_DATA_BLOB)]
    unprotect.restype = wintypes.BOOL
    free = kernel32.LocalFree
    free.argtypes = [ctypes.c_void_p]
    free.restype = ctypes.c_void_p
    buffer = (ctypes.c_ubyte * len(encrypted)).from_buffer_copy(encrypted)
    source = _DATA_BLOB(len(encrypted), ctypes.cast(buffer, ctypes.POINTER(ctypes.c_ubyte)))
    output = _DATA_BLOB()
    if not unprotect(ctypes.byref(source), None, None, None, None, 0,
                     ctypes.byref(output)):
        code = ctypes.get_last_error()
        raise RuntimeError('Could not read Number extension using this Windows user '
                           f'(DPAPI Windows error {code}). Use the same Windows account '
                           'that saved the extension numbers.')
    try:
        return ctypes.string_at(output.pbData, output.cbData)
    finally:
        if output.pbData:
            ctypes.memset(output.pbData, 0, output.cbData)
            free(ctypes.cast(output.pbData, ctypes.c_void_p))


def get_first_extension_number() -> str:
    """Fetch first saved number, preserving leading 0, plus signs, and order.

    Does not remove the number before confirmed successful Continue; does not copy to clipboard.
    """
    local = os.environ.get('LOCALAPPDATA')
    if not local:
        raise RuntimeError('LOCALAPPDATA is missing. Run via NexaBrowser on Windows.')
    source = Path(local) / 'FB UA Browser Lite' / 'SharedExtensions' / 'numbers.dpapi'
    if not source.is_file():
        raise RuntimeError('No saved Number extension list found. Add numbers in '
                           'NexaBrowser > Number extension first.')
    plaintext = _unprotect_current_user_dpapi(source.read_bytes())
    try:
        lines = plaintext.decode('utf-8').split('\n')
    except UnicodeDecodeError as exc:
        raise RuntimeError('Number extension data is not valid UTF-8.') from exc
    entries = [line.rstrip('\r') for line in lines if line.rstrip('\r')]
    if not entries:
        raise RuntimeError('Number extension list is empty. Add a number first.')
    first = entries[0]
    # An input control should only receive a telephone-like entry, not arbitrary
    # text. We do not normalize it, because the extension preserves the original.
    if any(char in first for char in '\r\n\t') or len(first) > 120:
        raise RuntimeError('First Number extension entry contains invalid characters.')
    return first


