class Cancelled(Exception):
    """User closed or cancelled the configuration form."""


@dataclass(frozen=True)
class Settings:
    url: str
    minimum_ms: int = 200
    maximum_ms: int = 500


def check_url(raw: str) -> str:
    value = raw.strip()
    if not value or any(char.isspace() for char in value):
        raise ValueError("Enter a website address without spaces.")
    if "://" not in value:
        value = "https://" + value
    parts = urlsplit(value)
    if parts.scheme.lower() not in ("http", "https") or not parts.hostname:
        raise ValueError("Only valid http:// or https:// URLs are supported.")
    if parts.username is not None or parts.password is not None:
        raise ValueError("Usernames/passwords embedded in URLs are not supported.")
    try:
        _ = parts.port
    except ValueError as exc:
        raise ValueError("Invalid port in URL.") from exc
    return value


def check_settings(url: str, minimum_ms: str | int, maximum_ms: str | int) -> Settings:
    try:
        minimum = int(str(minimum_ms).strip())
        maximum = int(str(maximum_ms).strip())
    except ValueError as exc:
        raise ValueError("Action Time values must be whole numbers (milliseconds).") from exc
    if minimum < 0 or maximum < minimum:
        raise ValueError("Action Time requires 0 <= Minimum <= Maximum.")
    if maximum > MAX_ACTION_DELAY_MS:
        raise ValueError("Maximum Action Time cannot exceed 3,600,000 ms (1 hour).")
    return Settings(check_url(url), minimum, maximum)


def settings_popup(default_url: str, default_min_ms: str, default_max_ms: str) -> Settings:
    """Display one GUI popup for link, min ms, max ms; raise on cancellation."""
    import tkinter as tk
    from tkinter import messagebox, ttk

    root = tk.Tk()
    root.title("NexaBrowser - Python Automation Settings")
    root.geometry("510x265")
    root.minsize(450, 265)
    root.resizable(True, False)
    root.attributes("-topmost", True)
    outer = ttk.Frame(root, padding=17)
    outer.pack(fill="both", expand=True)
    ttk.Label(outer, text="Website link", font=("Segoe UI", 10, "bold")).grid(
        row=0, column=0, columnspan=2, sticky="w", pady=(0, 4)
    )
    link = ttk.Entry(outer)
    link.grid(row=1, column=0, columnspan=2, sticky="ew", pady=(0, 13))
    link.insert(0, default_url or "https://")
    ttk.Label(outer, text="Minimum Action Time (ms)").grid(row=2, column=0, sticky="w", padx=(0, 12))
    ttk.Label(outer, text="Maximum Action Time (ms)").grid(row=2, column=1, sticky="w")
    minimum = ttk.Entry(outer)
    minimum.grid(row=3, column=0, sticky="ew", padx=(0, 12), pady=(4, 7))
    minimum.insert(0, default_min_ms)
    maximum = ttk.Entry(outer)
    maximum.grid(row=3, column=1, sticky="ew", pady=(4, 7))
    maximum.insert(0, default_max_ms)
    ttk.Label(outer, text="Every action gets a new random wait in this range.").grid(
        row=4, column=0, columnspan=2, sticky="w", pady=(0, 15)
    )
    outer.columnconfigure(0, weight=1)
    outer.columnconfigure(1, weight=1)
    result: list[Settings] = []

    def cancel() -> None:
        root.destroy()

    def save() -> None:
        try:
            config = check_settings(link.get(), minimum.get(), maximum.get())
        except ValueError as exc:
            messagebox.showerror("Invalid settings", str(exc), parent=root)
            return
        result.append(config)
        root.destroy()

    button_frame = ttk.Frame(outer)
    button_frame.grid(row=5, column=0, columnspan=2, sticky="e")
    ttk.Button(button_frame, text="Cancel", command=cancel).pack(side="left", padx=(0, 10))
    ttk.Button(button_frame, text="Start Automation", command=save).pack(side="left")
    root.bind("<Return>", lambda _event: save())
    root.protocol("WM_DELETE_WINDOW", cancel)
    link.focus_set()
    root.mainloop()
    if not result:
        raise Cancelled("Configuration cancelled.")
    return result[0]


def settings_from_runner_input(default_url: str, default_min_ms: str, default_max_ms: str) -> Settings:
    """Fallback when Tkinter is unavailable; Enter keeps the code defaults."""
    print(f"Website link [default: {default_url or '(none)'}] (blank = default):", flush=True)
    url = input().strip() or default_url
    print(f"Minimum action time (ms) [default: {default_min_ms}] (blank = default):", flush=True)
    minimum = input().strip() or default_min_ms
    print(f"Maximum action time (ms) [default: {default_max_ms}] (blank = default):", flush=True)
    maximum = input().strip() or default_max_ms
    return check_settings(url, minimum, maximum)


def get_settings() -> Settings:
    parser = argparse.ArgumentParser(description="NexaBrowser tab automation")
    parser.add_argument("url", nargs="?", help="Optional URL to pre-fill in the settings popup")
    parser.add_argument("--min-ms", default=str(DEFAULT_MIN_ACTION_TIME_MS),
                        help="Initial minimum action wait in ms")
    parser.add_argument("--max-ms", default=str(DEFAULT_MAX_ACTION_TIME_MS),
                        help="Initial maximum action wait in ms")
    args = parser.parse_args()
    default_url = args.url or DEFAULT_WEBSITE_URL
    # Never bypass the popup: URL and action-time values remain editable.
    try:
        return settings_popup(default_url, args.min_ms, args.max_ms)
    except (ImportError, ModuleNotFoundError, OSError, RuntimeError, EOFError) as exc:
        print("[info] GUI unavailable; using Runner input:", str(exc), flush=True)
        return settings_from_runner_input(default_url, args.min_ms, args.max_ms)


def action_wait(settings: Settings, action: str) -> None:
    """Fresh independent random delay before each click/fill."""
    milliseconds = random.randint(settings.minimum_ms, settings.maximum_ms)
    print(f"[wait] {action}: {milliseconds} ms", flush=True)
    time.sleep(milliseconds / 1000.0)


# A strict visible-button reader. Look in the main document and accessible
# same-origin iframes; do not mistake the other 'Find my account' button.
BUTTONS_JS = r"""
(() => {
  const wanted = new Set(['get started', 'find my account']);
  const found = new Set();
  function scan(doc) {
    for (const el of doc.querySelectorAll('button,a,[role="button"],input[type="button"],input[type="submit"]')) {
      const label = String(el.innerText || el.value || el.getAttribute('aria-label') || el.textContent || '')
        .trim().replace(/\s+/g, ' ').toLowerCase();
      if (!wanted.has(label) || el.disabled) continue;
      const rect = el.getBoundingClientRect();
      const st = doc.defaultView.getComputedStyle(el);
      if (rect.width > 0 && rect.height > 0 && st.visibility !== 'hidden' && st.display !== 'none') {
        found.add(label);
      }
    }
    for (const frame of doc.querySelectorAll('iframe')) {
      try { if (frame.contentDocument) scan(frame.contentDocument); } catch (_) {}
    }
  }
  scan(document);
  return Array.from(found);
})()
"""


def wait_for_get_started(browser: NexaBrowser, timeout: float = GET_STARTED_TIMEOUT) -> None:
    until = time.monotonic() + timeout
    seen_before: set[str] = set()
    while time.monotonic() < until:
        found = browser.evaluate(BUTTONS_JS)
        names = set(found) if isinstance(found, list) else set()
        if names != seen_before:
            if names:
                print("[buttons] " + ", ".join(sorted(names)), flush=True)
            seen_before = names
        if "get started" in names:
            return
        time.sleep(0.3)
    raise TimeoutError("Get Started button not found in 45 seconds (or is inside an inaccessible frame).")


# Locate input fields by *exact* normalized accessible labels / placeholders.
# The bridge's fill() accepts CSS selectors. The target is marked temporarily
# so generic unnamed inputs can be addressed precisely without guessing order.
FIELD_JS_TEMPLATE = r"""
(() => {
  const role = __ROLE__;
  const synonyms = role === 'first' ?
    new Set(['first name', 'firstname', 'given name', 'givenname', 'fname', 'given name(s)']) :
    new Set(['surname', 'sur name', 'last name', 'lastname', 'family name', 'familyname', 'lname']);
  const mark = 'data-nexa-py-field';
  function norm(x) {
    return String(x || '').toLowerCase().replace(/[_\-]+/g, ' ').replace(/\s+/g, ' ').trim();
  }
  const matches = [];
  const inputs = document.querySelectorAll('input,textarea');
  for (const el of inputs) {
    const type = norm(el.getAttribute('type') || 'text');
    if (!['text','search',''].includes(type) || el.disabled || el.readOnly) continue;
    const rect = el.getBoundingClientRect();
    const style = getComputedStyle(el);
    if (!rect.width || !rect.height || style.display === 'none' || style.visibility === 'hidden') continue;
    const labels = [
      el.getAttribute('placeholder'), el.getAttribute('aria-label'),
      el.getAttribute('name'), el.getAttribute('id'), el.getAttribute('autocomplete')
    ];
    if (el.labels) for (const label of el.labels) labels.push(label.innerText || label.textContent);
    const labelledby = el.getAttribute('aria-labelledby');
    if (labelledby) for (const id of labelledby.split(/\s+/)) {
      const source = document.getElementById(id);
      if (source) labels.push(source.textContent);
    }
    if (labels.some(label => synonyms.has(norm(label)))) matches.push(el);
  }
  for (const el of document.querySelectorAll('[' + mark + ']')) {
    if (el.getAttribute(mark) === role) el.removeAttribute(mark);
  }
  if (matches.length !== 1) return {status: matches.length ? 'ambiguous' : 'missing', count: matches.length};
  const target = matches[0];
  target.setAttribute(mark, role);
  return {status: 'ready', count: 1, value: target.value || ''};
})()
"""


def field_state(browser: NexaBrowser, role: str) -> dict:
    if role not in ("first", "surname"):
        raise ValueError("Unknown input role")
    response = browser.evaluate(FIELD_JS_TEMPLATE.replace("__ROLE__", json.dumps(role)))
    if not isinstance(response, dict):
        raise RuntimeError("Unable to inspect website fields")
    return response


def wait_for_fields(browser: NexaBrowser, timeout: float = FORM_TIMEOUT) -> None:
    until = time.monotonic() + timeout
    while time.monotonic() < until:
        first, surname = field_state(browser, "first"), field_state(browser, "surname")
        if first["status"] == "ambiguous" or surname["status"] == "ambiguous":
            raise RuntimeError("Several matching name fields were found. Refusing to guess.")
        if first["status"] == "ready" and surname["status"] == "ready":
            print("[form] Found First name and Surname fields.", flush=True)
            return
        time.sleep(0.3)
    raise TimeoutError("First name / Surname fields were not found in 45 seconds.")


def fill_and_confirm(browser: NexaBrowser, settings: Settings, role: str, name: str) -> None:
    state = field_state(browser, role)
    if state.get("status") != "ready":
        raise RuntimeError(f"{role} input missing or ambiguous immediately before fill")
    action_wait(settings, f"Fill {role}")
    selector = f'input[data-nexa-py-field="{role}"]'
    browser.fill(selector, name)
    check = field_state(browser, role)
    if check.get("status") != "ready" or check.get("value") != name:
        raise RuntimeError(f"{role} field did not retain the selected value; stopping")
    print(f"[filled] {role}: {name}", flush=True)


# ----- Date-of-birth and gender steps for authorized form testing -----
# The screenshots do not expose the page's DOM. Support standard HTML date
# inputs, separated day/month/year selects and inputs; reject unknown pickers
# rather than clicking an unrelated element or silently claiming success.

DATE_PROBE_JS = r"""
(() => {
  const tag = 'data-nexa-py-date';
  const visible = e => {
    const r=e.getBoundingClientRect(), st=getComputedStyle(e);
    return r.width>0 && r.height>0 && st.visibility!=='hidden' && st.display!=='none' && !e.disabled;
  };
  const norm = s => String(s||'').toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ').trim();
  const meta = e => [e.name,e.id,e.getAttribute('aria-label'),e.getAttribute('placeholder'),
    e.getAttribute('autocomplete'),e.labels && Array.from(e.labels).map(x=>x.innerText).join(' ')]
    .map(norm).join(' ');
  const names = { day:/(^|\s)(day|dd)(\s|$)/,month:/(^|\s)(month|mm)(\s|$)/,
                  year:/(^|\s)(year|yyyy|yy)(\s|$)/ };
  document.querySelectorAll('['+tag+']').forEach(e=>e.removeAttribute(tag));
  const dates = Array.from(document.querySelectorAll('input[type="date"]')).filter(visible);
  const dob = dates.filter(e=>/birth|dob/.test(meta(e)));
  if (dob.length===1 || (dates.length===1 && dob.length===0)) {
    (dob[0]||dates[0]).setAttribute(tag,'native');
    return {kind:'native',value:(dob[0]||dates[0]).value};
  }
  if (dates.length>1) return {kind:'ambiguous',reason:'Multiple date inputs'};
  for (const tagName of ['select','input']) {
    const fields = Array.from(document.querySelectorAll(tagName)).filter(e =>
      visible(e) && (tagName==='select' || ['text','number','tel'].includes(e.type)));
    const picked = {};
    for (const role of ['day','month','year']) {
      const matches=fields.filter(e=>names[role].test(meta(e)));
      if (matches.length===1) picked[role]=matches[0];
      else if(matches.length>1) return {kind:'ambiguous',reason:'Multiple '+role+' fields'};
    }
    if(Object.keys(picked).length===3) {
      for (const role of ['day','month','year']) picked[role].setAttribute(tag,role);
      return {kind:tagName==='select'?'split_select':'split_input',
        values:Object.fromEntries(Object.entries(picked).map(([k,e])=>[k,e.value]))};
    }
  }
  // Unknown custom picker; never assume an element's implementation from a screenshot.
  return {kind:'unsupported',reason:'No recognizable date input or day/month/year fields'};
})()
"""

DATE_SELECT_JS = r"""
(() => {
  const d = __DAY__, m=__MONTH__, y=__YEAR__;
  const names = {
    day:[String(d),String(d).padStart(2,'0')],
    month:[String(m),String(m).padStart(2,'0'),
      new Date(Date.UTC(2000,m-1,1)).toLocaleString('en-US',{month:'long'}),
      new Date(Date.UTC(2000,m-1,1)).toLocaleString('en-US',{month:'short'})],
    year:[String(y)]
  };
  const applied = {};
  for (const role of ['year','month','day']) {
    const e=document.querySelector('select[data-nexa-py-date="'+role+'"]');
    if(!e) return {error:'Missing date select: '+role};
    const norm=s=>String(s||'').trim().toLowerCase();
    const matching=Array.from(e.options).filter(o=>names[role].some(v=>norm(o.value)===norm(v) || norm(o.textContent)===norm(v)));
    if(matching.length!==1) return {error:'Cannot match date option '+role, candidates:matching.length};
    const setter=Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set;
    setter.call(e,matching[0].value);
    e.dispatchEvent(new Event('input',{bubbles:true}));
    e.dispatchEvent(new Event('change',{bubbles:true}));
    applied[role]=e.value;
  }
  return {ok:true,values:applied};
})()
"""

DATE_VERIFY_JS = r"""
(() => {
  const tag='data-nexa-py-date';
  const native=document.querySelector('input[type="date"]['+tag+'="native"]');
  if(native)return {kind:'native',value:native.value};
  const values={};
  for (const role of ['day','month','year']) {
    const el=document.querySelector('['+tag+'="'+role+'"]');
    if (!el) return {kind:'unknown'};
    values[role]=el.value;
    if (el.tagName==='SELECT') {
      values[role+'_label']=el.selectedOptions[0]?.textContent?.trim()||'';
    }
  }
  return {kind:'split',values};
})()
"""



OPEN_DOB_JS = r"""
(() => {
  const norm=s=>String(s||'').replace(/\s+/g,' ').toLowerCase().trim();
  const visible=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);
    return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden';};
  const allowed='button,[role="button"],[aria-haspopup],input[readonly],label';
  const matches=Array.from(document.querySelectorAll(allowed)).filter(e=>{
    if(!visible(e))return false;
    const label=norm(e.getAttribute('aria-label')||e.innerText||e.getAttribute('placeholder'));
    return label.startsWith('date of birth') && label.length<100;
  });
  document.querySelectorAll('[data-nexa-py-open-dob]').forEach(e=>e.removeAttribute('data-nexa-py-open-dob'));
  if(matches.length!==1)return {status:'unsupported',count:matches.length};
  matches[0].setAttribute('data-nexa-py-open-dob','true');
  return {status:'ready'};
})()
"""


def wait_for_date(browser: NexaBrowser, settings: Settings, timeout: float = FORM_TIMEOUT) -> dict:
    deadline = time.monotonic() + timeout
    last = None
    opened = False
    next_open_check = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        last = browser.evaluate(DATE_PROBE_JS)
        if isinstance(last, dict) and last.get('kind') in ('native','split_select','split_input'):
            return last
        if isinstance(last,dict) and last.get('kind') == 'ambiguous':
            raise RuntimeError('Date input is ambiguous: '+str(last.get('reason')))
        if not opened and time.monotonic() >= next_open_check:
            button = browser.evaluate(OPEN_DOB_JS)
            if isinstance(button,dict) and button.get('status') == 'ready':
                action_wait(settings,'Open Date of birth picker')
                browser.click('[data-nexa-py-open-dob="true"]')
                opened = True
                print('[date] Opened DOB picker; inspecting its fields.',flush=True)
            else:
                opened = True  # no unique safe DOB control; do not click blindly
        time.sleep(0.3)
    raise RuntimeError('Date picker is not a supported HTML input/select. It may be a custom picker. '
                       'Please provide its OPEN dropdown screenshot and DOM details for an exact adapter. '
                       'No date or Next click was attempted.')


def set_date(browser: NexaBrowser, settings: Settings, year: int, month: int, day: int) -> None:
    found=wait_for_date(browser,settings)
    iso=f'{year:04d}-{month:02d}-{day:02d}'
    print('[date] Selected test DOB:',iso,' (field type:',found['kind']+')',flush=True)
    if found['kind']=='native':
        action_wait(settings, 'Fill date of birth')
        browser.fill('input[data-nexa-py-date="native"]',iso)
        verified=browser.evaluate(DATE_VERIFY_JS)
        if verified.get('value') != iso:
            raise RuntimeError('Date did not retain '+iso+'; not clicking Next')
    elif found['kind']=='split_input':
        for role,val in [('day',day),('month',month),('year',year)]:
            action_wait(settings,'Fill date '+role)
            browser.fill('input[data-nexa-py-date="'+role+'"]',str(val))
        verified=browser.evaluate(DATE_VERIFY_JS)
        values=verified.get('values',{})
        if any(str(values.get(k,'')).lstrip('0') != str(v) for k,v in
               [('day',day),('month',month),('year',year)]):
            raise RuntimeError('Date fields did not retain their values; not clicking Next')
    else:
        # Select fields are changed ONE at a time, with a fresh randomized action wait.
        # Use the same option-matching logic but only change one dropdown per call.
        for role in ('year','month','day'):
            action_wait(settings,'Select date '+role)
            # In a dynamic form fields may re-render; re-mark after each change.
            latest=browser.evaluate(DATE_PROBE_JS)
            if latest.get('kind') != 'split_select':
                raise RuntimeError('Date dropdowns changed while filling; stopped')
            js=DATE_SELECT_JS.replace('__DAY__',str(day)).replace('__MONTH__',str(month)).replace('__YEAR__',str(year))
            # In this version the JS sets all three selects in a single invocation. To
            # preserve per-action delays, use a role-specific variant.
            js=js.replace("for (const role of ['year','month','day'])",f"for (const role of ['{role}'])")
            result=browser.evaluate(js)
            if not isinstance(result,dict) or result.get('ok') is not True:
                raise RuntimeError('Could not set '+role+': '+str(result))
        verified=browser.evaluate(DATE_VERIFY_JS)
        if verified.get('kind') != 'split':
            raise RuntimeError('Date dropdown validation unavailable')
        values=verified['values']
        # Compare the chosen option text or option value to calendar components.
        import calendar
        expected={
            'day':{str(day),f'{day:02d}'},
            'month':{str(month),f'{month:02d}',calendar.month_name[month],calendar.month_abbr[month]},
            'year':{str(year)}
        }
        for role in ('day','month','year'):
            if not ({str(values.get(role,'')),str(values.get(role+'_label',''))} & expected[role]):
                raise RuntimeError('Date dropdown '+role+' did not retain its selected value')
    print('[date] Fields validated.',flush=True)


GENDER_PROBE_JS = r"""
(() => {
  const norm=x=>String(x||'').trim().replace(/\s+/g,' ').toLowerCase();
  const visible=e=>{
    const r=e.getBoundingClientRect(),s=getComputedStyle(e);
    return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden';
  };
  const options={};
  for (const role of ['female','male']) {
    const matches=[];
    // Prefer explicit labels (clicking these changes the radio input naturally).
    for(const el of document.querySelectorAll('label,[role="radio"],button')) {
      if(!visible(el) || norm(el.innerText||el.getAttribute('aria-label'))!==role)continue;
