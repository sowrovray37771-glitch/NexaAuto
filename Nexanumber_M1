def click_continue_for_sms(browser: NexaBrowser, settings: Settings) -> bool:
    # Observe transition to verification-code entry before consuming a Number.
    state = sms_state(browser)
    if state.get('status') != 'ready' or state.get('selected') is not True:
        raise RuntimeError('SMS not verified as selected; Continue NOT clicked.')
    wait_for_exact_buttons(browser, ('Continue',))
    before = browser.evaluate(AFTER_CONTINUE_JS)
    action_wait(settings, 'Continue click after SMS selection')
    browser.click_text('Continue')
    print('[click] Continue clicked. Verifying page transition...', flush=True)
    deadline = time.monotonic() + FORM_TIMEOUT
    while time.monotonic() < deadline:
        try:
            result = browser.evaluate(AFTER_CONTINUE_JS)
        except NexaAutomationError:
            time.sleep(0.4)
            continue
        if isinstance(result, dict):
            if result.get('error'):
                raise RuntimeError('Page reported a send/verification error. Number was NOT deleted.')
            # New OTP/code page is the strongest confirmation of success.
            if result.get('codeInput') and not result.get('method'):
                print('[verification] Code-entry field appeared.', flush=True)
                return True
            if result.get('codeText') and not result.get('method'):
                print('[verification] Verification-code page appeared.', flush=True)
                return True
            # A changed URL alone is NOT proof that SMS was sent (it might be
            # a CAPTCHA or an error page). Keep the number if evidence is weak.
        time.sleep(0.35)
    raise TimeoutError('Continue was clicked but code page was not confirmed. Number was NOT deleted.')


def _protect_current_user_dpapi(plaintext: bytes) -> bytes:
    """Encrypt data with the same Windows DPAPI CurrentUser scheme as the app."""
    if os.name != 'nt':
        raise RuntimeError('Number extension updates require Windows DPAPI.')
    crypt32 = ctypes.WinDLL('crypt32', use_last_error=True)
    kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
    protect = crypt32.CryptProtectData
    protect.argtypes = [ctypes.POINTER(_DATA_BLOB), ctypes.c_wchar_p,
                        ctypes.POINTER(_DATA_BLOB), ctypes.c_void_p,
                        ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(_DATA_BLOB)]
    protect.restype = wintypes.BOOL
    local_free = kernel32.LocalFree
    local_free.argtypes = [ctypes.c_void_p]
    local_free.restype = ctypes.c_void_p
    buf = (ctypes.c_ubyte * len(plaintext)).from_buffer_copy(plaintext)
    source = _DATA_BLOB(len(plaintext), ctypes.cast(buf, ctypes.POINTER(ctypes.c_ubyte)))
    output = _DATA_BLOB()
    if not protect(ctypes.byref(source), None, None, None, None, 0,
                   ctypes.byref(output)):
        raise RuntimeError('Could not encrypt updated Number extension data (Windows error ' +
                           str(ctypes.get_last_error()) + ').')
    try:
        return ctypes.string_at(output.pbData, output.cbData)
    finally:
        if output.pbData:
            ctypes.memset(output.pbData, 0, output.cbData)
            local_free(ctypes.cast(output.pbData, ctypes.c_void_p))


def delete_used_top_number(expected_number: str) -> None:
    """Remove exactly one entry, only if the original top number is unchanged.

    Writes ONLY an encrypted temporary file, then atomically replaces the
    extension's encrypted file. Never writes plaintext or prints the number.
    Close the Number Extension editor before running automation: its in-memory
    list may overwrite an external change if the dialog remains open.
    """
    import tempfile
    local = os.environ.get('LOCALAPPDATA')
    if not local:
        raise RuntimeError('LOCALAPPDATA not found. Number was NOT deleted.')
    path = Path(local) / 'FB UA Browser Lite' / 'SharedExtensions' / 'numbers.dpapi'
    if not path.is_file():
        raise RuntimeError('Number Extension data disappeared; nothing deleted.')
    initial_stat = path.stat()
    raw = _unprotect_current_user_dpapi(path.read_bytes())
    try:
        original = raw.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise RuntimeError('Cannot decode Number Extension. Nothing deleted.') from exc
    # Keep the exact ordering, original newlines and any empty lines.
    parts = original.splitlines(keepends=True)
    first_index = next((i for i, line in enumerate(parts) if line.rstrip('\r\n')), None)
    if first_index is None:
        raise RuntimeError('Number Extension list empty. Nothing deleted.')
    if parts[first_index].rstrip('\r\n') != expected_number:
        raise RuntimeError('Top number changed during automation; nothing deleted.')
    new_plaintext = ''.join(parts[:first_index] + parts[first_index+1:]).encode('utf-8')
    encrypted = _protect_current_user_dpapi(new_plaintext)
    fd, tmp = tempfile.mkstemp(prefix='.numbers.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(encrypted)
            stream.flush()
            os.fsync(stream.fileno())
        check = path.stat()
        if (check.st_mtime_ns, check.st_size) != (initial_stat.st_mtime_ns, initial_stat.st_size):
            raise RuntimeError('Number Extension changed while script was running. Nothing deleted.')
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print('[number] Removed exactly the used top entry from Number Extension.', flush=True)

def run_flow(browser: NexaBrowser, settings: Settings) -> None:
    print('[1/16] Open URL in current NexaBrowser tab:', settings.url, flush=True)
    browser.navigate(settings.url)
    print('[2/16] Wait for Get Started...', flush=True)
    wait_for_get_started(browser)
    action_wait(settings,'Get Started click')
    browser.click_text('Get Started')
    print('[click] Get Started',flush=True)

    print('[3/16] Wait for name fields...',flush=True)
    wait_for_fields(browser)
    first=random.choice(FIRST_NAMES)
    surname=random.choice(SURNAMES)
    fill_and_confirm(browser,settings,'first',first)
    fill_and_confirm(browser,settings,'surname',surname)
    if (field_state(browser,'first').get('value') != first or
            field_state(browser,'surname').get('value') != surname):
        raise RuntimeError('Name fields lost their values; stopped')
    click_next(browser,settings,'name')

    # Example random DOB within the exact requested bounds.
    year=random.randint(1980,2000)
    month=random.randint(1,12)
    day=random.randint(1,28)
    print('[5/16] Wait for Date of birth fields...',flush=True)
    set_date(browser,settings,year,month,day)
    click_next(browser,settings,'date of birth')

    gender=random.choice(('Female','Male')) # 50% / 50% for independent draws
    print('[7/16] Wait for gender radio choices...',flush=True)
    select_gender(browser,settings,gender)
    click_next(browser,settings,'gender')
    print('[9/16] Wait for Mobile number field and read extension...',flush=True)
    used_number = fill_mobile_from_extension(browser,settings)
    click_next(browser,settings,'mobile number')
    print('[11/16] Wait for Password input and load saved extension text...', flush=True)
    fill_password_from_extension(browser, settings)
    click_next(browser, settings, 'password')
    print('[13/16] Wait for Save / Not now confirmation...', flush=True)
    click_save(browser, settings)
    print('[14/16] Wait for I agree...', flush=True)
    click_i_agree(browser, settings)
    print('[15/16] Wait for SMS verification choice...', flush=True)
    select_sms(browser, settings)
    print('[16/16] Click Continue...', flush=True)
    if click_continue_for_sms(browser, settings):
        action_wait(settings, 'Remove used Number extension entry')
        delete_used_top_number(used_number)
        print('[complete] Browser workflow finished; used Number entry removed.', flush=True)


def main() -> int:
    try:
        assert len(FIRST_NAMES) == len(set(FIRST_NAMES)) == 50
        assert len(SURNAMES) == len(set(SURNAMES)) == 50
        settings = get_settings()
        print(f"[settings] Action Time: {settings.minimum_ms}-{settings.maximum_ms} ms", flush=True)
        browser = NexaBrowser(timeout=60)
        run_flow(browser, settings)
        return 0
    except Cancelled:
        print("[cancelled] Nothing was opened.", flush=True)
        return 0
    except (ValueError, RuntimeError, TimeoutError, NexaAutomationError, EOFError) as exc:
        print(f"[error] {exc}", flush=True)
        print("[hint] Run from NexaAura > Python Runner in the updated NexaBrowser.", flush=True)
        return 1
    except KeyboardInterrupt:
        print("[stopped] User interrupted automation.", flush=True)
        return 130
    except Exception as exc:
        print(f"[unexpected error] {type(exc).__name__}: {exc}", flush=True)
        return 2


if __name__ == "__main__":
    sys.exit(main())
