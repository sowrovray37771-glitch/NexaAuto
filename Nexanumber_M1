      s.visibility !== 'hidden' && !el.disabled && !el.readOnly;
  };
  // The screenshot identifies one visible Password input. Do not guess if
  // multiple visible password inputs appear (e.g. password + confirmation).
  const matches = [...document.querySelectorAll('input[type="password"]')].filter(visible);
  document.querySelectorAll('[' + mark + ']').forEach(e => e.removeAttribute(mark));
  if (matches.length !== 1)
    return {status:matches.length ? 'ambiguous' : 'missing', count:matches.length};
  const field = matches[0];
  field.setAttribute(mark, 'true');
  return {status:'ready', value:field.value || ''};
})()
