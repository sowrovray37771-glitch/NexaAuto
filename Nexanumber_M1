def get_extension_password() -> str:
    local = os.environ.get('LOCALAPPDATA')
    if not local:
        raise RuntimeError('LOCALAPPDATA is missing; run in Windows NexaBrowser.')
    source = Path(local) / 'FB UA Browser Lite' / 'SharedExtensions' / 'password.dpapi'
    if not source.is_file():
        raise RuntimeError('Password extension has no saved text. Set it inside NexaBrowser first.')
    password_bytes = _unprotect_current_user_dpapi(source.read_bytes())
    try:
        password = password_bytes.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise RuntimeError('Saved Password extension text is not valid UTF-8.') from exc
    if not password:
        raise RuntimeError('Password extension saved value is empty.')
    if any(c in password for c in ('\r', '\n', '\x00')):
        raise RuntimeError('Password extension value cannot be used in a single-line password field.')
    return password


PASSWORD_FIELD_JS = r"""
